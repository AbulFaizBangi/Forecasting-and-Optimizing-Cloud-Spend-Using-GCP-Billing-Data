# =============================================================================
# .dockerignore
# Files excluded from the Docker build context.
# Keeps the image lean and prevents secrets / large files from leaking in.
# =============================================================================

# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
.eggs/

# Virtual environment
venv/
env/
.venv/

# Data — never bake the raw dataset into the image
Dataset/

# Artifacts — mounted as a volume at runtime instead
# (model.pkl, preprocessor.pkl, train.csv etc.)
artifacts/

# MLflow runs — mounted as volume
mlruns/

# Logs
logs/

# Notebooks — not needed in production
notebook/
*.ipynb
.ipynb_checkpoints/

# Tests — not needed in production image
tests/

# Git
.git/
.gitignore

# Environment files — never in image
.env
.env.*
*.env

# macOS
.DS_Store

# IDE
.vscode/
.idea/
*.swp
*.swo

# DVC
.dvc/
*.dvc

# Terraform
terraform/
*.tfstate
*.tfvars

# CI/CD config — not needed in image
.github/